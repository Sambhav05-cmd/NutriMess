{
  "name": "nutrimess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "import:data": "node scripts/import-catalog.js",
    "build:netlify": "node scripts/build-netlify.js",
    "migrate:sqlite": "node scripts/migrate-sqlite.js",
    "test:mongo": "node --test test/mongo-storage.test.js",
    "test": "node --test test/*.test.js",
    "dev:main": "NUTRIMESS_PLANNER=main node --watch server/index.js",
    "dev:legacy": "NUTRIMESS_PLANNER=legacy node --watch server/index.js",
    "test:current": "node --test test/food-analysis.test.js test/planner-modes.test.js experiments/gaussian/*.test.js",
    "test:main": "NUTRIMESS_PLANNER=main node --test test/local-experiment.test.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongodb": "^7.8.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
