# Optional local backend settings. npm start does not automatically load this file.
PORT=3000
HOST=127.0.0.1
# DB_PATH=/absolute/path/to/local/nutrimess.sqlite

# Required on Render / in production. Store the real URI only in secret settings.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nutrimess

# Netlify build: set this to the separately hosted backend's HTTPS origin.
# NUTRIMESS_API_ORIGIN=https://your-backend.example.com

# Backend: allow writes from the exact Netlify frontend origin.
# PUBLIC_ORIGIN=https://your-site.netlify.app
# Set only when the backend runs behind one trusted hosting reverse proxy.
# TRUST_PROXY=1

# Planner: gaussian (default), main (updated exponential), or legacy (original).
# NUTRIMESS_PLANNER=gaussian
# Optional: restore the original NITK nutrient source.
# NITK_NUTRITION_SOURCE=original
